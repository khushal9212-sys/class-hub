# Copy this file to `.env` (local dev) or set these as real environment
# variables on your host (Render / Railway / Heroku / etc.).

# Supabase service_role (secret) key. REQUIRED for admin deletes to work.
# Find it at: Supabase Dashboard -> Project Settings -> API -> service_role key.
# It looks like: sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEVER commit your real .env file or paste this key into the code/repo.
SUPABASE_SERVICE_KEY=sb_secret_REPLACE_ME
